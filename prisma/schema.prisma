generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Solicitante {
  id              Int       @id @default(autoincrement())
  nomeSolicitante String
  titulo          String
  descricao       String
  dataPedido      DateTime
  prazo           DateTime?
  dataEntrega     DateTime?
}

model Livro {
  id              Int      @id @default(autoincrement())
  autorID         Int
  autor           Autor    @relation(fields: [autorID], references: [id])
  titulo          String
  subtitulo       String
  editora         String
  data            Int      @db.SmallInt
  edicao          Int
  formato         String
  cdd             String
  tombado         Boolean  @default(false)
  disponivel      Boolean  @default(true)
  itensEmprestimo itemEmprestimo[]
}

model Autor {
  id              Int      @id @default(autoincrement())
  nome            String
  livros          Livro[]
}

enum PostoGraduacao {
  SC   // Servidor Civil
  SD   // Soldado
  CB   // Cabo
  SGT  // Sargento
  ST   // Subtenente
  ASP  // Aspirante-a-Oficial
  TEN  // Tenente
  CAP  // Capitão
  MAJ  // Major
  TC   // Tenente-Coronel
  CEL  // Coronel
}

model Aluno {
  id              Int      @id @default(autoincrement())
  pg              PostoGraduacao
  nome            String
  cpf             String   @unique @db.Char(11)
  emprestimos     emprestimo[]
}

model emprestimo {

  id Int @id @default(autoincrement())
  alunoId Int
  aluno Aluno @relation(fields:[alunoId],references:[id])
  itens itemEmprestimo[]
  dataEmprestimo DateTime @default(now())
  dataPrevistaDevolucao DateTime

}

model itemEmprestimo{
  id              Int      @id @default(autoincrement())

  emprestimoId    Int
  emprestimo emprestimo    @relation(fields:[emprestimoId],references:[id],onDelete: Cascade)

  livroId         Int
  livro Livro              @relation(fields:[livroId],references:[id])

  dataDevolucao DateTime?

}
