generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Solicitante {
  id              String   @id @default(uuid())
  nomeSolicitante String
  titulo          String
  descricao       String
  dataPedido      DateTime
  prazo           DateTime?
  dataEntrega     DateTime?
}

model Livro {
  id              String   @id @default(uuid())
  autorID         String
  autor           Autor    @relation(fields: [autorID], references: [id])
  titulo          String
  subtitulo       String
  editora         String
  data            Int      @db.SmallInt
  edicao          Int
  formato         String
  cdd             String
  tombado         Boolean  @default(false)
  disponivel      Boolean  @default(true)
  itensEmprestimo itemEmprestimo[]
}

model Autor {
  id              String   @id @default(uuid())
  nome            String
  livros          Livro[]
}

enum PostoGraduacao {
  SC   // Servidor Civil
  SD   // Soldado
  CB   // Cabo
  SGT  // Sargento
  ST   // Subtenente
  ASP  // Aspirante-a-Oficial
  TEN  // Tenente
  CAP  // Capitão
  MAJ  // Major
  TC   // Tenente-Coronel
  CEL  // Coronel
}

model Aluno {
  id              String   @id @default(uuid())
  pg              PostoGraduacao
  nome            String
  cpf             String   @unique @db.Char(11)
  emprestimos     emprestimo[]
}

model emprestimo {

  id              String   @id @default(uuid())
  alunoId String
  aluno Aluno @relation(fields:[alunoId],references:[id])
  itens itemEmprestimo[]
  dataEmprestimo DateTime @default(now())
  dataPrevistaDevolucao DateTime

}

model itemEmprestimo{
  id              String   @id @default(uuid())

  emprestimoId    String
  emprestimo emprestimo    @relation(fields:[emprestimoId],references:[id],onDelete: Cascade)

  livroId         String
  livro Livro              @relation(fields:[livroId],references:[id])

  dataDevolucao DateTime?

}

model Usuario {
  id        String   @id @default(cuid())
  usuario   String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
}
