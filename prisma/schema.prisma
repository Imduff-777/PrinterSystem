generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Solicitantes {
  id              Int      @id @default(autoincrement())
  nomeSolicitante String
  titulo          String
  descricao       String
  dataPedido      DateTime
  prazo           DateTime? 
  dataEntrega     DateTime?
}

model Livros {
  id              Int      @id @default(autoincrement())
  autor           String
  titulo          String
  subtitulo       String
  editora         String
  data            DateTime
  edicao          Int
  formato         String
  QntLivro        Int
  cdd             Int

}