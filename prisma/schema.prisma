generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Solicitante {
  id              Int       @id @default(autoincrement())
  nomeSolicitante String
  titulo          String
  descricao       String
  dataPedido      DateTime
  prazo           DateTime?
  dataEntrega     DateTime?
}

model Livro {
  id              Int      @id @default(autoincrement())
  autorID         Int
  autor           Autor    @relation(fields: [autorID], references: [id])
  titulo          String
  subtitulo       String
  editora         String
  data            DateTime
  edicao          Int
  formato         String
  QntLivro        Int
  cdd             Int
}

model Autor {
  id              Int      @id @default(autoincrement())
  nome            String
  livros          Livro[]
}